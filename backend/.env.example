MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/?appName=Cluster0
PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Redis/BullMQ connection (use REDIS_URL in hosted environments)
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Ollama settings
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_LLM_MODEL=llama3

# Provider selection
EMBEDDING_PROVIDER=ollama
LLM_PROVIDER=ollama

# Gemini settings (required only when provider is gemini)
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_LLM_MODEL=gemini-2.5-flash

# Security
REQUIRE_API_KEY=true
API_KEY=rm_replace_with_secure_key

# API rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
