{
  "name": "resume_matcher",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "npm run dev:api",
    "dev:api": "ts-node-dev --respawn --transpile-only apps/api/server.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only workers/ingestionWorker.ts",
    "db:ensure-indexes": "ts-node scripts/ensureVectorIndex.ts",
    "build": "tsc",
    "lint": "eslint \"{apps,core,infrastructure,queues,scripts,services,shared,tests,workers}/**/*.ts\"",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md,yml,yaml}\"",
    "test": "npm run build && node --test dist/tests/**/*.test.js",
    "start": "node dist/apps/api/server.js",
    "start:worker": "node dist/workers/ingestionWorker.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tusharagrawal3011/Resume_Matcher.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/tusharagrawal3011/Resume_Matcher/issues"
  },
  "homepage": "https://github.com/tusharagrawal3011/Resume_Matcher#readme",
  "dependencies": {
    "bullmq": "^5.66.2",
    "dotenv": "^17.2.3",
    "express-rate-limit": "^7.5.1",
    "express": "^5.2.1",
    "ioredis": "^5.8.2",
    "mongodb": "^7.0.0",
    "pdf-parse": "^2.4.5",
    "yarn": "^1.22.22",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
